rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validSchedule() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'date', 'minutes', 'repeat', 'steps', 'reminder']) &&
        d.keys().hasOnly(['title', 'date', 'minutes', 'repeat', 'steps', 'reminder']) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 60 &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.minutes is int && d.minutes >= 0 && d.minutes < 1440 &&
        d.repeat in ['ONCE', 'DAILY', 'WEEKLY'] &&
        d.steps is list && d.steps.size() <= 10 && d.reminder is bool;
    }

    match /lifeGuideUsers/{elderUid}/scheduleEditors/{familyUid} {
      // The consent flow creates or deletes this document as the elder.
      allow read: if owns(elderUid) || owns(familyUid);
      allow create, update: if owns(elderUid) &&
        request.resource.data.keys().hasOnly(['active']) &&
        request.resource.data.active == true;
      allow delete: if owns(elderUid);
    }
    match /lifeGuideUsers/{elderUid}/schedules/{scheduleId} {
      function mayEdit() {
        return signedIn() &&
          exists(/databases/$(database)/documents/lifeGuideUsers/$(elderUid)/scheduleEditors/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/lifeGuideUsers/$(elderUid)/scheduleEditors/$(request.auth.uid)).data.active == true;
      }
      allow read, delete: if owns(elderUid) || mayEdit();
      allow create, update: if (owns(elderUid) || mayEdit()) && validSchedule();
    }
  }
}
